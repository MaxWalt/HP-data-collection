# Strava — create an app at https://www.strava.com/settings/api
# then run: python strava_auth.py  to get your refresh token
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# intervals.icu — find your API key at https://intervals.icu/settings (Developer Settings)
# Athlete ID: the part after /athlete/ in your profile URL, e.g. i12345
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
